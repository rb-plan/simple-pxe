[Unit]
Description=Sync the intranet debian-security mirror
After=network-online.target zfs-mount.service
Wants=network-online.target
RequiresMountsFor=/srv/mirror

[Service]
Type=oneshot
User=nick
Group=users
ExecStart=/home/nick/Public/simple-pxe/boot/mirror/debmirror-sync.sh security
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3h
RuntimeMaxSec=1h
# 75 = another sync (e.g. the first manual one) holds the lock: skip quietly
SuccessExitStatus=75

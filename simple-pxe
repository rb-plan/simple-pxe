#!/bin/bash

source functions.sh
source boot/gen-boot-ipxe.sh

export {ARCHLINUX,ROCKY,DEBIAN_CD,DEBIAN,FEDORA,FREEBSD,NETBSD,UBUNTU,UBUNTU_RELEASES}_MIRROR
export {ARCHLINUX,ROCKY,DEBIAN_CD,DEBIAN,FEDORA,FREEBSD,NETBSD,UBUNTU,UBUNTU_RELEASES}_MIRROR_BACKUP

mirror_base="http://mirrors.ustc.edu.cn"
ARCHLINUX_MIRROR="${mirror_base}/archlinux"
ROCKY_MIRROR="${mirror_base}/rocky"
DEBIAN_CD_MIRROR="${mirror_base}/debian-cd"
DEBIAN_MIRROR="${mirror_base}/debian"
FEDORA_MIRROR="${mirror_base}/fedora"
FREEBSD_MIRROR="${mirror_base}/freebsd"
NETBSD_MIRROR="https://mirrors.bfsu.edu.cn/NetBSD"
UBUNTU_MIRROR="${mirror_base}/ubuntu"
UBUNTU_RELEASES_MIRROR="${mirror_base}/ubuntu-releases"

export PXE_LOCAL_ROOT PXE_HTTP_ROOT PXE_NFS_HOST PXE_NFS_ROOT PXE_DOWNLOADS
export FREEBSD_VERSIONS FREEBSD_ARCHES DEBIAN_NETBOOT_CACHE DEBIAN_NETBOOT_SUITES
export DEBIAN_ARCHES DEBIAN_USE_LOCAL_MIRROR DEBIAN_LOCAL_MIRROR DEBIAN_LOCAL_SECURITY_MIRROR
export DEBIAN_LOCAL_SUITES DEBIAN_UPSTREAM_MIRROR DEBIAN_SECURITY_MIRROR DEBIAN_FIRMWARE_MIRROR DEBIAN_FIRMWARE_SUITES
export PXE_DISKLESS_DEBIAN PXE_IMAGES_ROOT PXE_IMAGES_URL PXE_DISKLESS_DEBIAN_DIR PXE_DISKLESS_DEBIAN_ARGS PXE_DISKLESS_DEBIAN_TITLE
export PXE_IPXE_TITLE PXE_IPXE_DEFAULT PXE_IPXE_TIMEOUT PXE_IPXE_DEBIAN_SUITES PXE_IPXE_GRUB
declare -a PXE_PREPARE PXE_MENUS
source config.local

# Operator-provided big assets (ISOs, netboot tarballs); see functions.sh.
: "${PXE_DOWNLOADS:=$(dirname -- "${PXE_LOCAL_ROOT}")/downloads}"
: "${FREEBSD_ARCHES:=amd64}"
: "${DEBIAN_NETBOOT_CACHE:=auto}"
: "${DEBIAN_NETBOOT_SUITES:=stable testing}"

# Debian mirror selection. DEBIAN_MIRROR / DEBIAN_SECURITY_MIRROR end up as the effective
# mirrors used by the preseed and the GRUB entries:
#   DEBIAN_USE_LOCAL_MIRROR=0 (default): the upstream mirror (DEBIAN_MIRROR, USTC)
#   DEBIAN_USE_LOCAL_MIRROR=1: DEBIAN_LOCAL_MIRROR (the hub's own mirror, boot/mirror/),
#     limited to DEBIAN_LOCAL_SUITES in the menu
: "${DEBIAN_ARCHES:=amd64}"
: "${DEBIAN_USE_LOCAL_MIRROR:=0}"
: "${DEBIAN_LOCAL_SUITES:=bookworm trixie}"
: "${DEBIAN_UPSTREAM_MIRROR:=${DEBIAN_MIRROR}}"
: "${DEBIAN_FIRMWARE_MIRROR:=http://mirrors.ustc.edu.cn/debian-cdimage/firmware}"
: "${DEBIAN_FIRMWARE_SUITES:=bookworm trixie}"
if [[ "${DEBIAN_USE_LOCAL_MIRROR}" == 1 ]]; then
	[[ -n "${DEBIAN_LOCAL_MIRROR}" ]] || panick "DEBIAN_USE_LOCAL_MIRROR=1 needs \$DEBIAN_LOCAL_MIRROR"
	DEBIAN_MIRROR="${DEBIAN_LOCAL_MIRROR}"
	DEBIAN_SECURITY_MIRROR="${DEBIAN_LOCAL_SECURITY_MIRROR:-${DEBIAN_LOCAL_MIRROR%/debian}/debian-security}"
else
	DEBIAN_SECURITY_MIRROR="${DEBIAN_UPSTREAM_SECURITY_MIRROR:-${DEBIAN_UPSTREAM_MIRROR%/debian}/debian-security}"
fi

validate_config() {
	[[ -d "${PXE_LOCAL_ROOT}" ]] || panick "\$PXE_LOCAL_ROOT is not a valid directory"
	[[ -n "${PXE_HTTP_ROOT}" ]] || panick "Please set \$PXE_HTTP_ROOT"
	[[ -n "${PXE_NFS_HOST}" ]] || panick "Please set \$PXE_NFS_HOST"
	[[ -n "${PXE_NFS_ROOT}" ]] || panick "Please set \$PXE_NFS_ROOT"
}

parse_header() {
	# PXE_LOCAL_ROOT ->  LOCAL_PATH
	# PXE_HTTP_ROOT  ->  HTTP_PATH
	#                    GRUB_PATH
	# PXE_NFS_ROOT   ->  NFS_PATH

	unset header && declare -Ag header
	local fullpath filename key value

	fullpath="$1"
	filename=$(basename -- "${fullpath}")
	filename="${filename%.*}"

	while read -r line; do
		if [[ "${line}" =~ ^\#([[:alnum:]]+):[[:space:]]*(.*)$ ]]; then
			key="${BASH_REMATCH[1]}"
			value="${BASH_REMATCH[2]}"
			header["${key}"]="${value}"
		fi
	done < "${fullpath}"

	[[ -z "${header[root]}" ]] && header[root]="${filename}"

	ASSET_PATH=$(readlink -m "$(dirname "${fullpath}")/${filename}")
	LOCAL_PATH="${PXE_LOCAL_ROOT}/${header[root]}"
	HTTP_PATH="${PXE_HTTP_ROOT}/${header[root]}"
	GRUB_PATH=$(url2grub "${HTTP_PATH}")
	NFS_PATH="${PXE_NFS_ROOT}/${header[root]}"
	export ASSET_PATH LOCAL_PATH HTTP_PATH GRUB_PATH NFS_PATH
}

do_prepare() {
	local failed=()
	for item in "${PXE_PREPARE[@]}"; do
		script="prepare.d/${item}.sh"

		if [[ -f "${script}" ]]; then
			echo "Run ${script}..."
			parse_header "${script}"
			mkdir -p "${LOCAL_PATH}"
			bash "${script}" || failed+=("${item}")
		fi
	done

	if (( ${#failed[@]} > 0 )); then
		panick "Prepare failed: %s" "${failed[*]}"
	fi
	echo "Prepare OK"
}

do_menu() {
	menu_dir="${PXE_LOCAL_ROOT}/menu"
	menu_url=$(url2grub "${PXE_HTTP_ROOT}/menu")
	mkdir -p "${menu_dir}"

	menu_root="${menu_dir}/root.menu"
	temp[menu_root]=$(mktemp)

	intro_flag=0
	if [[ -n "${PXE_INTRO}" ]]; then
		echo "${PXE_INTRO}" > "${PXE_LOCAL_ROOT}/intro.txt"
		intro_flag=1
	fi

	cat >> "${temp[menu_root]}" <<- EOF
		set menu_color_highlight=${GRUB_COLOR_HIGHLIGHT:-white/red}
		set menu_color_normal=${GRUB_COLOR_NORMAL:-white/blue}
		export menu_color_highlight
		export menu_color_normal

		if [ "\$feature_all_video_module" = "y" ]; then
		  insmod all_video
		else
		  for mod in efi_gop efi_uga ieee1275_fb vbe vga video_bochs video_cirrus; do
		    insmod \$mod
		  done
		fi

		menuentry '${PXE_TITLE:-Network Boot Service}' {
		  if [ ${intro_flag} = 1 ]; then
		    set pager=1
		    cat $(url2grub "${PXE_HTTP_ROOT}/intro.txt")
		    echo "Press any key to continue"
		    read
		  fi
		}
	EOF

	for item in "${PXE_MENUS[@]}"; do
		if [[ ${item:0:1} == "-" ]]; then
			grub_menu_sep "<${item:1}>" >> "${temp[menu_root]}"
			continue
		fi

		local script="menu.d/${item}.sh"
		local menu_file="${menu_dir}/${item}.menu"
		export PXE_MENU_URL="${menu_url}/${item}.menu"

		if [[ -f "${script}" ]]; then
			parse_header "${script}"
			echo "Generating menu item '${header[menu]}'..."

			id="do_menu_${item}"
			temp[${id}]=$(mktemp)

			cat >> "${temp[${id}]}" <<- EOF
				menuentry '..' {
				  configfile "${menu_url}/root.menu"
				}
			EOF

			if bash "${script}" >> "${temp[${id}]}"; then
				chmod 644 "${temp[${id}]}"
				mv "${temp[${id}]}" "${menu_file}"
			else
				echo "${item}: failed to generate menu"
			fi
		fi

		if [[ -f "${menu_file}" ]]; then
			cat >> "${temp[menu_root]}" <<- EOF
				menuentry '- ${header[menu]}' {
				  configfile "${PXE_MENU_URL}"
				}
			EOF
		fi
	done

	chmod 644 "${temp[menu_root]}"
	mv "${temp[menu_root]}" "${menu_root}"
}

# main {{{
readonly ACTION="${1:-menu}"
validate_config

case "${ACTION}" in
	prepare)
		do_prepare
		;;
	menu)
		do_menu
		;;
	ipxe-menu)
		gen_boot_ipxe "${2:-}"
		;;
	*)
		panick "Unknown action: ${ACTION}"
		;;
esac
# }}}

